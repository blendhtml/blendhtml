<section class="mx-auto mt-12 max-w-xl rounded-2xl border border-slate-200 bg-white p-6 shadow-xl shadow-slate-900/5 sm:p-9">
    <p class="mb-3 text-sm font-medium uppercase tracking-wider text-slate-500">
        {{ self.data.kicker|e }}
    </p>

    <h1 class="text-3xl font-bold leading-tight tracking-tight text-slate-900 sm:text-4xl">
        {{ self.data.title|e }}
    </h1>

    <p class="mt-4 text-lg leading-7 text-slate-600">
        {{ self.data.description|e }}
    </p>

    {% if page.error %}
        <div
                class="mt-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm leading-6 text-red-800"
                role="alert"
        >
            {{ self.data.errors[page.error]|e }}
        </div>
    {% endif %}

    {% if page.pending %}
        <form method="post" action="" class="mt-7 grid gap-3">
            <input
                    type="hidden"
                    name="_csrf"
                    value="{{ page.csrfToken|e('html_attr') }}"
            >

            <label
                    class="text-sm font-semibold text-slate-900"
                    for="auth-code"
            >
                {{ self.data.code_label|e }}
            </label>

            <input
                    class="min-h-12 w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-center font-mono text-2xl tracking-[.25em] text-slate-900 outline-none transition focus:border-indigo-600 focus:ring-4 focus:ring-indigo-600/15"
                    id="auth-code"
                    name="code"
                    type="text"
                    maxlength="{{ page.codeLength }}"
                    minlength="{{ page.codeLength }}"
                    pattern="[0-9]*"
                    inputmode="numeric"
                    autocomplete="one-time-code"
                    required
                    autofocus
            >

            <button
                    class="mt-1 min-h-12 rounded-xl bg-slate-900 px-5 py-3 text-base font-semibold text-white transition hover:bg-slate-800 focus:outline-none focus:ring-4 focus:ring-slate-900/15"
                    type="submit"
            >
                {{ self.data.submit|e }}
            </button>
        </form>
    {% endif %}

    <p class="mt-6 text-center text-sm text-slate-600">
        <a
                class="font-medium text-indigo-600 underline underline-offset-2 hover:text-indigo-500"
                href="{{ page.restartUrl|e('html_attr') }}"
        >
            {{ self.data.restart|e }}
        </a>
    </p>
</section>