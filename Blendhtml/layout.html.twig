{% extends '@blendhtml/layout.html.twig' %}

{% block css %}
<style>
    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f6f7fb;
        color: #172033;
    }

    .bhtml-page {
        max-width: 920px;
        margin: 0 auto;
        padding: 56px 24px;
    }

    .bhtml-card {
        background: #fff;
        border: 1px solid #e5e8f0;
        border-radius: 18px;
        box-shadow: 0 14px 40px rgba(23, 32, 51, .08);
        padding: 32px;
    }

    .bhtml-kicker {
        color: #516070;
        font-size: 14px;
        letter-spacing: .08em;
        margin: 0 0 12px;
        text-transform: uppercase;
    }

    .bhtml-title {
        font-size: 42px;
        line-height: 1.1;
        margin: 0 0 16px;
    }

    .bhtml-text {
        color: #516070;
        font-size: 18px;
        line-height: 1.65;
        margin: 0;
    }

    .bhtml-list {
        color: #516070;
        line-height: 1.8;
        margin: 22px 0 0;
        padding-left: 22px;
    }

    .bhtml-code {
        background: #111827;
        border-radius: 12px;
        color: #f9fafb;
        display: inline-block;
        font-family: Consolas, Monaco, monospace;
        font-size: 14px;
        margin-top: 22px;
        padding: 12px 14px;
    }
</style>
{% endblock %}
