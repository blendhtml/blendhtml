<style>
    body {
        margin: 0;
        padding: 2rem;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 14px;
        line-height: 1.5;
        color: #222;
        background: #f5f5f5;
    }

    h1 {
        margin: 0 0 2rem;
        font-size: 28px;
    }

    h2 {
        margin: 2.5rem 0 1rem;
        font-size: 20px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        border: 1px solid #ddd;
    }

    th,
    td {
        padding: 10px 12px;
        border-bottom: 1px solid #ddd;
        border-right: 1px solid #eee;
        text-align: left;
        vertical-align: top;
    }

    th {
        font-weight: 600;
        background: #eee;
        white-space: nowrap;
    }

    tbody tr:hover {
        background: #fafafa;
    }

    td {
        max-width: 400px;
    }

    pre {
        margin: 0;
        padding: 8px;
        overflow-x: auto;
        font-family: monospace;
        font-size: 12px;
        line-height: 1.4;
        white-space: pre-wrap;
        word-break: break-word;
        background: #f5f5f5;
        border: 1px solid #ddd;
        border-radius: 4px;
    }

    p {
        color: #666;
    }

    @media (max-width: 1200px) {
        body {
            padding: 1rem;
        }

        table {
            display: block;
            overflow-x: auto;
        }
    }
</style>

<h1>Visit Metrics</h1>

<h2>Activity</h2>

{% if activities is empty %}
    <p>No activity records.</p>
{% else %}
    <table>
        <thead>
        <tr>
            <th>Visitor token</th>
            <th>Timestamp</th>
            <th>Action</th>
            <th>Event</th>
            <th>Seconds</th>
            <th>Ref</th>
            <th>Event ID</th>
            <th>Client Timestamp</th>
            <th>Referrer</th>
            <th>Meta</th>
        </tr>
        </thead>

        <tbody>
        {% for activity in activities %}
            <tr>
                <td>{{ activity.visitorToken ?? '' }}</td>
                <td>{{ activity.timestamp|date('Y-m-d H:i:s') }}</td>
                <td>{{ activity.action }}</td>
                <td>{{ activity.event ?? '' }}</td>
                <td>{{ activity.seconds ?? '' }}</td>
                <td>{{ activity.ref ?? '' }}</td>
                <td>{{ activity.eventId }}</td>
                <td>{{ activity.clientTimestamp|date('Y-m-d H:i:s.v') }}</td>
                <td>{{ activity.referrer ?? '' }}</td>
                <td>
                    {% if activity.meta is not null %}
                        <pre>
                            {{ activity.meta|json_encode(
                                constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE')
                            ) }}
                        </pre>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}


<h2>Consent</h2>

{% if consents is empty %}
    <p>No consent records.</p>
{% else %}
    <table>
        <thead>
        <tr>
            <th>Visitor Token</th>
            <th>Timestamp</th>
            <th>Action</th>
            <th>Referrer</th>
            <th>Location</th>
            <th>Errors</th>
        </tr>
        </thead>

        <tbody>
        {% for consent in consents %}
            <tr>
                <td>{{ consent.visitorToken ?? '' }}</td>
                <td>{{ consent.timestamp|date('Y-m-d H:i:s') }}</td>
                <td>{{ consent.action }}</td>
                <td>{{ consent.referrer ?? '' }}</td>

                <td>
                    {% if consent.location is not null %}
                        <pre>{{ consent.location|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                    {% endif %}
                </td>

                <td>
                    {% if consent.errors is not empty %}
                        <pre>{{ consent.errors|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}