<section class="mx-auto mt-6 w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-lg shadow-slate-900/5">
        <h2 class="text-xl font-bold text-slate-900">
            {{ self.data.section_title|e }}
        </h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">
            {{ self.data.section_description|e }}
        </p>

        {% if page.noticeArea == 'roles' and page.notice %}
            <div class="mt-5 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800" role="status">
                {{ self.data.notices[page.notice]|e }}
            </div>
        {% endif %}

        {% if page.errorArea == 'roles' and page.error %}
            <div class="mt-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
                {{ page.error|e }}
            </div>
        {% endif %}

        <form method="post" action="" class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-end">
            <input type="hidden" name="_csrf" value="{{ page.csrfToken|e('html_attr') }}">
            <input type="hidden" name="action" value="create_role">
            <input type="hidden" name="return_page" value="{{ page.pagination.current }}">

            <label class="flex-1">
                <span class="mb-2 block text-sm font-semibold text-slate-900">
                    {{ self.data.role_label|e }}
                </span>
                <input
                        class="min-h-11 w-full rounded-xl border border-slate-300 px-3 py-2 font-mono text-slate-900 outline-none transition focus:border-indigo-600 focus:ring-4 focus:ring-indigo-600/15"
                        type="text"
                        name="role"
                        maxlength="64"
                        pattern="[a-z][a-z0-9_-]*"
                        placeholder="{{ self.data.role_placeholder|e('html_attr') }}"
                        required
                >
            </label>

            <button class="min-h-11 rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-600/15" type="submit">
                {{ self.data.create|e }}
            </button>
        </form>

        <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {% for role in page.roles %}
                <div class="flex items-center justify-between gap-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
                    <code class="break-all text-sm font-semibold text-slate-800">
                        {{ role.name|e }}
                    </code>

                    {% if role.protected %}
                        <span class="shrink-0 rounded-full bg-slate-200 px-2.5 py-1 text-xs font-semibold text-slate-600">
                            {{ self.data.protected|e }}
                        </span>
                    {% else %}
                        <form
                                method="post"
                                action=""
                                {% if role.bound %}onsubmit="return window.confirm('{{ self.data.delete_bound_confirmation|e('js') }}');"{% endif %}
                        >
                            <input type="hidden" name="_csrf" value="{{ page.csrfToken|e('html_attr') }}">
                            <input type="hidden" name="action" value="delete_role">
                            <input type="hidden" name="role" value="{{ role.name|e('html_attr') }}">
                            <input type="hidden" name="return_page" value="{{ page.pagination.current }}">

                            <button class="rounded-lg border border-red-200 bg-white px-3 py-1.5 text-xs font-semibold text-red-700 transition hover:bg-red-50 focus:outline-none focus:ring-4 focus:ring-red-600/10" type="submit">
                                {{ self.data.delete|e }}
                            </button>
                        </form>
                    {% endif %}
                </div>
            {% else %}
                <p class="text-sm text-slate-500">
                    {{ self.data.empty|e }}
                </p>
            {% endfor %}
        </div>
    </div>
</section>
