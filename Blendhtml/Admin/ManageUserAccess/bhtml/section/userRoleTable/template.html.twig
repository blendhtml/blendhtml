<section class="mx-auto mb-12 mt-6 w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="rounded-2xl border border-slate-200 bg-white shadow-lg shadow-slate-900/5">
        <div class="p-6">
            <h2 class="text-xl font-bold text-slate-900">
                {{ self.data.section_title|e }}
            </h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">
                {{ self.data.section_description|e }}
            </p>

            {% if page.noticeArea == 'users' and page.notice %}
                <div class="mt-5 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800" role="status">
                    {{ self.data.notices[page.notice]|e }}
                </div>
            {% endif %}

            {% if page.errorArea == 'users' and page.error %}
                <div class="mt-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
                    {{ page.error|e }}
                </div>
            {% endif %}

            <form method="post" action="" class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-end">
                <input type="hidden" name="_csrf" value="{{ page.csrfToken|e('html_attr') }}">
                <input type="hidden" name="action" value="create_user">
                <input type="hidden" name="return_page" value="{{ page.pagination.current }}">

                <label class="flex-1">
                    <span class="mb-2 block text-sm font-semibold text-slate-900">
                        {{ self.data.new_user_email|e }}
                    </span>
                    <input
                            class="min-h-11 w-full rounded-xl border border-slate-300 px-3 py-2 text-slate-900 outline-none transition focus:border-indigo-600 focus:ring-4 focus:ring-indigo-600/15"
                            type="email"
                            name="email"
                            maxlength="254"
                            placeholder="{{ self.data.email_placeholder|e('html_attr') }}"
                            autocomplete="email"
                            required
                    >
                </label>

                <button class="min-h-11 rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-600/15" type="submit">
                    {{ self.data.create_user|e }}
                </button>
            </form>
        </div>

        <div class="overflow-x-auto border-y border-slate-200">
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500" scope="col">
                        {{ self.data.email|e }}
                    </th>
                    <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500" scope="col">
                        {{ self.data.roles|e }}
                    </th>
                    <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500" scope="col">
                        {{ self.data.actions|e }}
                    </th>
                </tr>
                </thead>

                <tbody class="divide-y divide-slate-200 bg-white">
                {% for user in page.users %}
                    <tr class="transition hover:bg-slate-50">
                        <td class="whitespace-nowrap px-6 py-5 align-top">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-slate-900">
                                    {{ user.email|e }}
                                </span>

                                {% if user.id == page.currentUserId %}
                                    <span class="rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-semibold text-indigo-700">
                                        {{ self.data.current_user|e }}
                                    </span>
                                {% endif %}
                            </div>
                        </td>

                        <td class="px-6 py-5">
                            <form method="post" action="">
                                <input type="hidden" name="_csrf" value="{{ page.csrfToken|e('html_attr') }}">
                                <input type="hidden" name="action" value="sync_user_roles">
                                <input type="hidden" name="user_id" value="{{ user.id }}">
                                <input type="hidden" name="return_page" value="{{ page.pagination.current }}">

                                {% if page.roleNames is empty %}
                                    <p class="text-sm text-slate-500">
                                        {{ self.data.no_roles|e }}
                                    </p>
                                {% else %}
                                    <div class="flex flex-wrap gap-2">
                                        {% for role in page.roleNames %}
                                            <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:border-indigo-300 hover:bg-indigo-50">
                                                <input
                                                        class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
                                                        type="checkbox"
                                                        name="roles[]"
                                                        value="{{ role|e('html_attr') }}"
                                                        {% if role in user.roles %}checked{% endif %}
                                                >
                                                <code>{{ role|e }}</code>
                                            </label>
                                        {% endfor %}
                                    </div>
                                {% endif %}

                                <button class="mt-3 min-h-10 rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-700 focus:outline-none focus:ring-4 focus:ring-slate-900/15" type="submit">
                                    {{ self.data.save|e }}
                                </button>
                            </form>
                        </td>

                        <td class="whitespace-nowrap px-6 py-5 align-top">
                            <form
                                    method="post"
                                    action=""
                                    onsubmit="return window.confirm('{{ self.data.delete_confirmation|e('js') }}');"
                            >
                                <input type="hidden" name="_csrf" value="{{ page.csrfToken|e('html_attr') }}">
                                <input type="hidden" name="action" value="delete_user">
                                <input type="hidden" name="user_id" value="{{ user.id }}">
                                <input type="hidden" name="return_page" value="{{ page.pagination.current }}">

                                <button class="min-h-10 rounded-lg border border-red-200 bg-red-50 px-4 py-2 text-sm font-semibold text-red-700 transition hover:bg-red-100 focus:outline-none focus:ring-4 focus:ring-red-600/10" type="submit">
                                    {{ self.data.delete|e }}
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td class="px-6 py-10 text-center text-sm text-slate-500" colspan="3">
                            {{ self.data.no_users|e }}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-sm text-slate-600">
                {{ self.data.showing
                    |replace({
                        '{{from}}': page.pagination.from,
                        '{{to}}': page.pagination.to,
                        '{{total}}': page.pagination.total
                    })
                    |e
                }}
            </p>

            {% if page.pagination.pageCount > 1 %}
                <nav class="flex flex-wrap items-center gap-2" aria-label="{{ self.data.pagination_label|e('html_attr') }}">
                    {% if page.pagination.previousUrl %}
                        <a class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" href="{{ page.pagination.previousUrl|e('html_attr') }}">
                            {{ self.data.previous|e }}
                        </a>
                    {% endif %}

                    {% for paginationPage in page.pagination.pages %}
                        <a
                                class="min-w-10 rounded-lg px-3 py-2 text-center text-sm font-semibold transition {{ paginationPage == page.pagination.current ? 'bg-indigo-600 text-white' : 'border border-slate-300 bg-white text-slate-700 hover:bg-slate-50' }}"
                                href="{{ page.pagination.urls[paginationPage]|e('html_attr') }}"
                                {% if paginationPage == page.pagination.current %}aria-current="page"{% endif %}
                        >
                            {{ paginationPage }}
                        </a>
                    {% endfor %}

                    {% if page.pagination.nextUrl %}
                        <a class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" href="{{ page.pagination.nextUrl|e('html_attr') }}">
                            {{ self.data.next|e }}
                        </a>
                    {% endif %}
                </nav>
            {% endif %}
        </div>
    </div>
</section>
