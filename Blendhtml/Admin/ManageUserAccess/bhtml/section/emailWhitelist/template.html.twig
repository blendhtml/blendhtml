{% if page.mode == 'whitelist' %}
<section class="mx-auto mt-6 w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-lg shadow-slate-900/5">
        <h2 class="text-xl font-bold text-slate-900">
            {{ self.data.section_title|e }}
        </h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">
            {{ self.data.section_description|e }}
        </p>

        {% if page.noticeArea == 'whitelist' and page.notice %}
            <div class="mt-5 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800" role="status">
                {{ self.data.notices[page.notice]|e }}
            </div>
        {% endif %}

        {% if page.errorArea == 'whitelist' and page.error %}
            <div class="mt-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
                {{ page.error|e }}
            </div>
        {% endif %}

        <form method="post" action="" class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-end">
            <input type="hidden" name="_csrf" value="{{ page.csrfToken|e('html_attr') }}">
            <input type="hidden" name="action" value="add_whitelist">
            <input type="hidden" name="return_page" value="{{ page.pagination.current }}">

            <label class="flex-1">
                <span class="mb-2 block text-sm font-semibold text-slate-900">
                    {{ self.data.email_label|e }}
                </span>
                <input
                        class="min-h-11 w-full rounded-xl border border-slate-300 px-3 py-2 text-slate-900 outline-none transition focus:border-indigo-600 focus:ring-4 focus:ring-indigo-600/15"
                        type="email"
                        name="email"
                        maxlength="254"
                        placeholder="{{ self.data.email_placeholder|e('html_attr') }}"
                        autocomplete="email"
                        required
                >
            </label>

            <button class="min-h-11 rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-600/15" type="submit">
                {{ self.data.add|e }}
            </button>
        </form>

        <div class="mt-6 overflow-hidden rounded-xl border border-slate-200">
            {% if page.whitelist is empty %}
                <p class="px-4 py-6 text-center text-sm text-slate-500">
                    {{ self.data.empty|e }}
                </p>
            {% else %}
                <ul class="divide-y divide-slate-200">
                    {% for email in page.whitelist %}
                        <li class="flex flex-col gap-3 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
                            <span class="break-all font-medium text-slate-800">
                                {{ email|e }}
                            </span>

                            <form method="post" action="">
                                <input type="hidden" name="_csrf" value="{{ page.csrfToken|e('html_attr') }}">
                                <input type="hidden" name="action" value="remove_whitelist">
                                <input type="hidden" name="email" value="{{ email|e('html_attr') }}">
                                <input type="hidden" name="return_page" value="{{ page.pagination.current }}">

                                <button class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm font-semibold text-red-700 transition hover:bg-red-100 focus:outline-none focus:ring-4 focus:ring-red-600/10" type="submit">
                                    {{ self.data.remove|e }}
                                </button>
                            </form>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </div>
</section>
{% endif %}
