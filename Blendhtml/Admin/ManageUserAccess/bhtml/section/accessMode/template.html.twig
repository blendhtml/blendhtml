<section class="mx-auto mt-10 w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
        <p class="text-sm font-semibold uppercase tracking-wider text-indigo-600">
            {{ self.data.kicker|e }}
        </p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
            {{ self.data.title|e }}
        </h1>
        <p class="mt-3 max-w-3xl text-base leading-7 text-slate-600">
            {{ self.data.description|e }}
        </p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-lg shadow-slate-900/5">
        <div>
            <h2 class="text-xl font-bold text-slate-900">
                {{ self.data.section_title|e }}
            </h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">
                {{ self.data.section_description|e }}
            </p>
        </div>

        {% if page.noticeArea == 'mode' and page.notice %}
            <div class="mt-5 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800" role="status">
                {{ self.data.notices[page.notice]|e }}
            </div>
        {% endif %}

        {% if page.errorArea == 'mode' and page.error %}
            <div class="mt-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
                {{ page.error|e }}
            </div>
        {% endif %}

        <form method="post" action="" class="mt-6">
            <input type="hidden" name="_csrf" value="{{ page.csrfToken|e('html_attr') }}">
            <input type="hidden" name="action" value="set_mode">
            <input type="hidden" name="return_page" value="{{ page.pagination.current }}">

            <div class="grid gap-4 md:grid-cols-2">
                <label class="cursor-pointer rounded-xl border p-5 transition hover:border-indigo-400 hover:bg-indigo-50/40 {{ page.mode == 'any' ? 'border-indigo-500 bg-indigo-50' : 'border-slate-200' }}">
                    <span class="flex items-start gap-3">
                        <input
                                class="mt-1 h-4 w-4 border-slate-300 text-indigo-600 focus:ring-indigo-500"
                                type="radio"
                                name="mode"
                                value="any"
                                {% if page.mode == 'any' %}checked{% endif %}
                        >
                        <span>
                            <span class="block font-semibold text-slate-900">
                                {{ self.data.any_title|e }}
                            </span>
                            <span class="mt-1 block text-sm leading-6 text-slate-600">
                                {{ self.data.any_description|e }}
                            </span>
                        </span>
                    </span>
                </label>

                <label class="cursor-pointer rounded-xl border p-5 transition hover:border-indigo-400 hover:bg-indigo-50/40 {{ page.mode == 'whitelist' ? 'border-indigo-500 bg-indigo-50' : 'border-slate-200' }}">
                    <span class="flex items-start gap-3">
                        <input
                                class="mt-1 h-4 w-4 border-slate-300 text-indigo-600 focus:ring-indigo-500"
                                type="radio"
                                name="mode"
                                value="whitelist"
                                {% if page.mode == 'whitelist' %}checked{% endif %}
                        >
                        <span>
                            <span class="block font-semibold text-slate-900">
                                {{ self.data.whitelist_title|e }}
                            </span>
                            <span class="mt-1 block text-sm leading-6 text-slate-600">
                                {{ self.data.whitelist_description|e }}
                            </span>
                        </span>
                    </span>
                </label>
            </div>

            <button class="mt-5 min-h-11 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-700 focus:outline-none focus:ring-4 focus:ring-slate-900/15" type="submit">
                {{ self.data.save|e }}
            </button>
        </form>
    </div>
</section>
