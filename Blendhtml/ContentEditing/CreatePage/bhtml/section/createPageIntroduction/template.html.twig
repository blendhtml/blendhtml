<section class="mx-auto mt-10 w-full max-w-5xl px-4 sm:px-6 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-wider text-indigo-600">
        {{ self.data.kicker|e }}
    </p>

    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        {{ self.data.title|e }}
    </h1>

    <p class="mt-3 max-w-3xl text-base leading-7 text-slate-600">
        {{ self.data.description|e }}
    </p>

    {% if page.submitted %}
        <div class="mt-6 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-4 text-sm leading-6 text-emerald-800" role="status">
            {{ self.data.success|e }}
        </div>
    {% endif %}

    {% if page.error %}
        <div class="mt-6 rounded-xl border border-red-200 bg-red-50 px-4 py-4 text-sm leading-6 text-red-800" role="alert">
            {{ self.data.errors[page.error]|e }}
        </div>
    {% endif %}
</section>
