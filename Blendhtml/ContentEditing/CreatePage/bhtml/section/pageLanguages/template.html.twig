<section class="mx-auto mt-6 w-full max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-lg shadow-slate-900/5">
        <fieldset>
            <legend class="text-xl font-bold text-slate-900">
                {{ self.data.title|e }}
            </legend>

            <p class="mt-2 text-sm leading-6 text-slate-600">
                {{ self.data.description|e }}
            </p>

            <div class="mt-6 grid gap-3 sm:grid-cols-3">
                {% for code in ['et', 'en', 'ru'] %}
                    <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 transition hover:border-indigo-400 hover:bg-indigo-50/40">
                        <input
                                class="h-5 w-5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
                                type="checkbox"
                                name="languages[]"
                                value="{{ code|e('html_attr') }}"
                                form="create-page-form"
                                {% if code in page.selectedLanguages %}checked{% endif %}
                        >

                        <span>
                            <span class="block font-semibold text-slate-900">
                                {{ self.data.languages[code]|e }}
                            </span>
                            <code class="mt-0.5 block text-xs uppercase text-slate-500">
                                {{ code|e }}
                            </code>
                        </span>
                    </label>
                {% endfor %}
            </div>

            <p
                    id="create-page-languages-error"
                    class="mt-3 hidden text-sm font-semibold text-red-700"
                    role="alert"
            >
                {{ self.data.required|e }}
            </p>
        </fieldset>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('create-page-form');
            const checkboxes = Array.from(
                document.querySelectorAll('input[name="languages[]"][form="create-page-form"]')
            );
            const error = document.getElementById('create-page-languages-error');

            if (!form || checkboxes.length === 0 || !error) {
                return;
            }

            const validateLanguages = function () {
                const valid = checkboxes.some(function (checkbox) {
                    return checkbox.checked;
                });

                error.classList.toggle('hidden', valid);

                return valid;
            };

            form.addEventListener('submit', function (event) {
                if (!validateLanguages()) {
                    event.preventDefault();
                    checkboxes[0].focus();
                }
            });

            checkboxes.forEach(function (checkbox) {
                checkbox.addEventListener('change', validateLanguages);
            });
        });
    </script>
</section>
