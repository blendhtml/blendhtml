<section class="mx-auto mt-6 w-full max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-lg shadow-slate-900/5">
        <h2 class="text-xl font-bold text-slate-900">
            {{ self.data.title|e }}
        </h2>

        <p class="mt-2 text-sm leading-6 text-slate-600">
            {{ self.data.description|e }}
        </p>

        <label class="mt-6 block" for="create-page-url">
            <span class="mb-2 block text-sm font-semibold text-slate-900">
                {{ self.data.label|e }}
            </span>

            <input
                    class="min-h-12 w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 font-mono text-base text-slate-900 outline-none transition focus:border-indigo-600 focus:ring-4 focus:ring-indigo-600/15 disabled:cursor-not-allowed disabled:bg-slate-100"
                    id="create-page-url"
                    name="url"
                    type="text"
                    value="{{ page.desiredUrl|e('html_attr') }}"
                    placeholder="{{ self.data.placeholder|e('html_attr') }}"
                    maxlength="2048"
                    pattern="/(?:[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*)?"
                    form="create-page-form"
                    required
                    {% if not page.homepageExists %}readonly{% endif %}
            >
        </label>

        <p class="mt-2 text-sm leading-6 text-slate-500">
            {% if page.homepageExists %}
                {{ self.data.format_help|e }}
            {% else %}
                {{ self.data.homepage_help|e }}
            {% endif %}
        </p>
    </div>
</section>
