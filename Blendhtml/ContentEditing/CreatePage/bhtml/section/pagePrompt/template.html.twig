<section class="mx-auto mt-6 w-full max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-lg shadow-slate-900/5">
        <h2 class="text-xl font-bold text-slate-900">
            {{ self.data.title|e }}
        </h2>

        <p class="mt-2 text-sm leading-6 text-slate-600">
            {{ self.data.description|e }}
        </p>

        <label class="mt-6 block" for="create-page-prompt">
            <span class="mb-2 block text-sm font-semibold text-slate-900">
                {{ self.data.label|e }}
            </span>

            <textarea
                    class="min-h-96 w-full resize-y rounded-xl border border-slate-300 bg-white px-4 py-3 text-base leading-7 text-slate-900 outline-none transition focus:border-indigo-600 focus:ring-4 focus:ring-indigo-600/15"
                    id="create-page-prompt"
                    name="prompt"
                    maxlength="50000"
                    placeholder="{{ self.data.placeholder|e('html_attr') }}"
                    form="create-page-form"
                    required
            >{{ page.prompt|e }}</textarea>
        </label>
    </div>
</section>
